  "patchTestCases": {
    "debian-based": [
      {
        "name": "Security Updates Only",
        "command": "apt-get upgrade --security-only",
        "category": "Security",
        "estimatedInstallTime": "5-15 minutes",
        "requiresReboot": "sometimes",
        "notes": "Install only security patches"
      },
      {
        "name": "All Updates",
        "command": "apt-get upgrade -y",
        "category": "All",
        "estimatedInstallTime": "10-30 minutes",
        "requiresReboot": "sometimes",
        "notes": "Update all packages"
      },
      {
        "name": "Distribution Upgrade",
        "command": "apt-get dist-upgrade -y",
        "category": "Distribution",
        "estimatedInstallTime": "30-60 minutes",
        "requiresReboot": true,
        "notes": "Major version upgrade (use with caution)"
      },
      {
        "name": "Kernel Update",
        "command": "apt-get install linux-image-generic",
        "category": "Kernel",
        "estimatedInstallTime": "5-10 minutes",
        "requiresReboot": true,
        "notes": "Update kernel"
      }
    ],
    "rhel-based": [
      {
        "name": "Security Updates Only",
        "command": "dnf upgrade --security -y",
        "category": "Security",
        "estimatedInstallTime": "5-15 minutes",
