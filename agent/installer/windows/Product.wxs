<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi"
     xmlns:util="http://schemas.microsoft.com/wix/UtilExtension">

  <?define ProductName = "PatchIQ Agent" ?>
  <?define ProductVersion = "$(var.Version)" ?>
  <?define ProductManufacturer = "PatchIQ" ?>
  <?define UpgradeCode = "8B2F5C4A-9E1D-4F3A-B6C7-D8E9F0A1B2C3" ?>

  <Product Id="*"
           Name="$(var.ProductName)"
           Language="1033"
           Version="$(var.ProductVersion)"
           Manufacturer="$(var.ProductManufacturer)"
           UpgradeCode="$(var.UpgradeCode)">

    <Package InstallerVersion="500"
             Compressed="yes"
             InstallScope="perMachine"
             Description="PatchIQ Agent - Endpoint Management Agent"
             Manufacturer="$(var.ProductManufacturer)"
             Comments="Installs PatchIQ Agent as a Windows Service"
             Platform="x64" />

    <!-- Require Windows 10 or later -->
    <Condition Message="This application requires Windows 10 or later.">
      <![CDATA[Installed OR VersionNT >= 603]]>
    </Condition>

    <!-- Require 64-bit Windows -->
    <Condition Message="This application requires a 64-bit version of Windows.">
      <![CDATA[VersionNT64]]>
    </Condition>

    <!-- Upgrade handling -->
    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed."
                  AllowSameVersionUpgrades="yes"
                  Schedule="afterInstallInitialize" />

    <!-- Embed CAB in MSI for single-file distribution -->
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- Properties for silent install -->
    <Property Id="SERVERURL" Value="http://localhost:5001/api" Secure="yes" />
    <Property Id="UIPORT" Value="5003" Secure="yes" />

    <!-- Feature definition -->
    <Feature Id="ProductFeature" Title="PatchIQ Agent" Level="1">
      <ComponentGroupRef Id="ProductComponents" />
      <ComponentGroupRef Id="ServiceComponents" />
      <ComponentGroupRef Id="ConfigComponents" />
    </Feature>

    <!-- Directory structure -->
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="PatchIQ">
          <Directory Id="LOGFOLDER" Name="logs" />
        </Directory>
      </Directory>
      <Directory Id="CommonAppDataFolder">
        <Directory Id="DATAFOLDER" Name="PatchIQ">
          <Directory Id="CONFIGFOLDER" Name="config" />
        </Directory>
      </Directory>
    </Directory>

    <!-- Minimal UI -->
    <UIRef Id="WixUI_Minimal" />
    <UIRef Id="WixUI_ErrorProgressText" />
    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />

    <!-- Icon for Add/Remove Programs -->
    <Icon Id="PatchIQ.ico" SourceFile="patchiq.ico" />
    <Property Id="ARPPRODUCTICON" Value="PatchIQ.ico" />
    <Property Id="ARPHELPLINK" Value="https://patchiq.io/support" />
    <Property Id="ARPURLINFOABOUT" Value="https://patchiq.io" />

  </Product>

  <!-- Component Groups -->
  <Fragment>
    <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">
      <Component Id="MainExecutable" Guid="A1B2C3D4-E5F6-7890-ABCD-EF1234567890" Win64="yes">
        <File Id="PatchIQAgent"
              Name="patchiq-agent.exe"
              Source="$(var.BuildDir)\patchiq-agent.exe"
              KeyPath="yes" />
      </Component>

      <Component Id="LogsDirectory" Guid="B2C3D4E5-F6A7-8901-BCDE-F23456789012" Win64="yes">
        <CreateFolder Directory="LOGFOLDER" />
        <RegistryKey Root="HKLM" Key="SOFTWARE\PatchIQ\Folders">
          <RegistryValue Name="LogsDir" Type="string" Value="[LOGFOLDER]" KeyPath="yes" />
        </RegistryKey>
      </Component>
    </ComponentGroup>

    <ComponentGroup Id="ServiceComponents" Directory="INSTALLFOLDER">
      <Component Id="ServiceComponent" Guid="C3D4E5F6-A7B8-9012-CDEF-345678901234" Win64="yes">
        <File Id="ServiceExe"
              Name="patchiq-service.exe"
              Source="$(var.BuildDir)\patchiq-service.exe"
              KeyPath="yes" />

        <ServiceInstall Id="PatchIQService"
                        Type="ownProcess"
                        Name="PatchIQAgent"
                        DisplayName="PatchIQ Agent"
                        Description="PatchIQ Endpoint Management Agent - Collects inventory and telemetry"
                        Start="auto"
                        Account="LocalSystem"
                        ErrorControl="normal">
          <util:ServiceConfig FirstFailureActionType="restart"
                              SecondFailureActionType="restart"
                              ThirdFailureActionType="restart"
                              ResetPeriodInDays="1"
                              RestartServiceDelayInSeconds="60" />
        </ServiceInstall>

        <ServiceControl Id="StartPatchIQService"
                        Start="install"
                        Stop="both"
                        Remove="uninstall"
                        Name="PatchIQAgent"
                        Wait="yes" />
      </Component>
    </ComponentGroup>

    <ComponentGroup Id="ConfigComponents" Directory="CONFIGFOLDER">
      <Component Id="DataDirectory" Guid="D4E5F6A7-B8C9-0123-DEF0-456789012345" Win64="yes">
        <CreateFolder Directory="DATAFOLDER" />
        <CreateFolder Directory="CONFIGFOLDER" />
        <RegistryKey Root="HKLM" Key="SOFTWARE\PatchIQ">
          <RegistryValue Name="DataDir" Type="string" Value="[DATAFOLDER]" KeyPath="yes" />
          <RegistryValue Name="InstallDir" Type="string" Value="[INSTALLFOLDER]" />
          <RegistryValue Name="Version" Type="string" Value="$(var.Version)" />
        </RegistryKey>
      </Component>

      <Component Id="EnvVars" Guid="E5F6A7B8-C9D0-1234-EF01-567890123456" Win64="yes">
        <RegistryKey Root="HKLM" Key="SOFTWARE\PatchIQ\Environment">
          <RegistryValue Name="Configured" Type="integer" Value="1" KeyPath="yes" />
        </RegistryKey>
        <Environment Id="PATCHIQ_DATA_DIR"
                     Action="set"
                     Name="PATCHIQ_DATA_DIR"
                     Part="all"
                     Permanent="no"
                     System="yes"
                     Value="[DATAFOLDER]" />
        <Environment Id="PATCHIQ_SERVER_URL"
                     Action="set"
                     Name="PATCHIQ_SERVER_URL"
                     Part="all"
                     Permanent="no"
                     System="yes"
                     Value="[SERVERURL]" />
      </Component>

      <Component Id="DefaultConfig" Guid="F6A7B8C9-D0E1-2345-F012-678901234567" Win64="yes">
        <File Id="ConfigJson"
              Name="config.json"
              Source="default-config.json"
              KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>

</Wix>
