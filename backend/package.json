{
  "name": "patchiq-backend",
  "version": "1.0.0",
  "description": "PatchIQ Backend API Server",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon --exec ts-node -r tsconfig-paths/register src/server.ts",
    "build": "tsc",
    "start": "node -r tsconfig-paths/register dist/server.js",
    "test": "jest --testPathIgnorePatterns='e2e|performance'",
    "test:watch": "jest --watch --testPathIgnorePatterns='e2e|performance'",
    "test:coverage": "jest --coverage --testPathIgnorePatterns='e2e|performance'",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration",
    "test:e2e": "jest tests/e2e --runInBand --testTimeout=60000",
    "test:e2e:auth": "jest tests/e2e/auth.e2e.test.ts --runInBand",
    "test:e2e:agents": "jest tests/e2e/agents.e2e.test.ts --runInBand",
    "test:e2e:assets": "jest tests/e2e/assets.e2e.test.ts --runInBand",
    "test:e2e:patches": "jest tests/e2e/patches.e2e.test.ts --runInBand",
    "test:e2e:vulnerabilities": "jest tests/e2e/vulnerabilities.e2e.test.ts --runInBand",
    "test:e2e:jobs": "jest tests/e2e/jobs.e2e.test.ts --runInBand",
    "test:e2e:workflow": "jest tests/e2e/full-workflow.e2e.test.ts --runInBand",
    "test:e2e:msw": "jest tests/e2e/msw-compatibility.e2e.test.ts --runInBand",
    "test:e2e:coverage": "jest tests/e2e --runInBand --coverage --testTimeout=60000",
    "test:performance": "jest tests/performance --runInBand --testTimeout=120000",
    "test:all": "jest --runInBand --testTimeout=60000",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "db:migrate": "prisma migrate dev",
    "db:migrate:prod": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "ts-node -r tsconfig-paths/register src/db/prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate",
    "db:reset": "prisma migrate reset --force"
  },
  "keywords": [
    "patchiq",
    "patch-management",
    "vulnerability-management",
    "security"
  ],
  "author": "PatchIQ Team",
  "license": "PROPRIETARY",
  "dependencies": {
    "@prisma/client": "^5.10.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "date-fns": "^3.3.1",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "uuid": "^9.0.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.11.20",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^9.0.8",
    "@typescript-eslint/eslint-plugin": "^7.0.2",
    "@typescript-eslint/parser": "^7.0.2",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.3",
    "prettier": "^3.2.5",
    "prisma": "^5.10.0",
    "supertest": "^6.3.4",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
