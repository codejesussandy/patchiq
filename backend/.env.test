# Server
NODE_ENV=test
PORT=5002
API_VERSION=v1
CORS_ORIGIN=http://localhost:5001

# Database (use the dev database — test data uses E2E-TEST prefix to avoid collisions)
DATABASE_URL=postgresql://postgres:postgres@localhost:3002/patchiq_dev?connection_limit=5

# JWT
JWT_SECRET=test-jwt-secret-key-for-testing-only
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Rate Limiting (disabled for tests)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=10000

# Logging
LOG_LEVEL=error

# Session Settings
SESSION_ABSOLUTE_TIMEOUT_HOURS=8
SESSION_IDLE_TIMEOUT_MINUTES=30

# External Services (always mock in tests)
USE_MOCK_NVD=true
USE_MOCK_EMAIL=true
USE_MOCK_LDAP=true
USE_MOCK_PATCHES=true

# Encryption Key
ENCRYPTION_KEY=test-32-byte-encryption-key-here
