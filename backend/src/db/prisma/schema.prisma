// ============================================
// Discovery Models
// ============================================

model IPRange {
  id                  String    @id @default(uuid())
  name                String
  range               String    // CIDR notation (e.g., "192.168.1.0/24")
  description         String?
  credentialId        String?   @map("credential_id")
  credential          DeviceCredential? @relation(fields: [credentialId], references: [id])
  scanScheduleType    String?   @map("scan_schedule_type") // 'once' | 'daily' | 'weekly'
  scanScheduleTime    String?   @map("scan_schedule_time")
  scanScheduleDay     Int?      @map("scan_schedule_day")
  lastScanned         DateTime? @map("last_scanned")
  deviceCount         Int       @default(0) @map("device_count")
  status              String    @default("active") // 'active' | 'inactive'
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  scans               DiscoveryScan[]
  discoveredDevices   DiscoveredDevice[]

  @@map("ip_ranges")
}

model DeviceCredential {
  id            String   @id @default(uuid())
  name          String
  type          String   // 'SSH' | 'Windows' | 'SNMP' | 'WinRM'
  username      String?
  passwordEnc   String?  @map("password_enc") // AES-256 encrypted
  domain        String?
  snmpCommunity String?  @map("snmp_community")
  snmpVersion   String?  @map("snmp_version") // 'v2c' | 'v3'
  port          Int?
  description   String?
  lastUsed      DateTime? @map("last_used")
  createdBy     String?  @map("created_by")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  ipRanges      IPRange[]

  @@map("device_credentials")
}

model DiscoveryScan {
  id            String    @id @default(uuid())
  ipRangeId     String    @map("ip_range_id")
  ipRange       IPRange   @relation(fields: [ipRangeId], references: [id], onDelete: Cascade)
  status        String    @default("pending") // 'pending' | 'in_progress' | 'completed' | 'failed'
  devicesFound  Int       @default(0) @map("devices_found")
  startedAt     DateTime? @map("started_at")
  completedAt   DateTime? @map("completed_at")
  errorMessage  String?   @map("error_message")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([ipRangeId, status])
  @@map("discovery_scans")
}

model DiscoveredDevice {
  id            String    @id @default(uuid())
  ipRangeId     String    @map("ip_range_id")
  ipRange       IPRange   @relation(fields: [ipRangeId], references: [id], onDelete: Cascade)
  ipAddress     String    @map("ip_address")
  hostname      String?
  macAddress    String?   @map("mac_address")
  deviceType    String?   @map("device_type")
  os            String?
  vendor        String?
  openPorts     Int[]     @default([]) @map("open_ports")
  status        String    @default("discovered") // 'discovered' | 'enrolled' | 'ignored'
  assetId       String?   @unique @map("asset_id")
  discoveredAt  DateTime  @default(now()) @map("discovered_at")
  lastSeenAt    DateTime  @default(now()) @map("last_seen_at")

  @@unique([ipRangeId, ipAddress])
  @@index([status])
  @@map("discovered_devices")
}

