  scope            String   @default("all") // all | windows | mac | linux
  endpoints        String[] @default([])
  deploymentPolicy String?  @map("deployment_policy")
  retryCount       Int      @default(1) @map("retry_count")
  notifyTo         String   @default("admin") @map("notify_to") // admin | user
  stage            String   @default("IN_PROGRESS") // COMPLETED | IN_PROGRESS | INSTALLED | FAILED
  pending          Int      @default(0)
  succeeded        Int      @default(0)
  failed           Int      @default(0)
  createdBy        String?  @map("created_by")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  tasks ConfigDeploymentTask[]

  @@index([stage])
  @@map("config_deployments")
}

model ConfigDeploymentTask {
  id           String           @id @default(uuid())
  deploymentId String           @map("deployment_id")
  deployment   ConfigDeployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)
  endpointId   String?          @map("endpoint_id")
  endpointName String           @map("endpoint_name")
  endpointOs   String           @map("endpoint_os")
  itemName     String           @map("item_name")
  status       String           @default("PENDING") // SUCCESS | FAILED | PENDING | IN_PROGRESS
  createdBy    String?          @map("created_by")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  @@index([deploymentId])
  @@index([status])
  @@map("config_deployment_tasks")
}

model DeploymentPolicy {
  id              String   @id @default(uuid())
  policyId        String   @unique @map("policy_id")
  name            String
  description     String?
  type            String   @default("INSTANT") // SCHEDULE | INSTANT
  supportedModule String   @default("All") @map("supported_module") // All | Patch | Update | Security
  relatedType     String   @default("No Relation") @map("related_type") // No Relation | Critical | Important | Optional
  createdBy       String?  @map("created_by")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([type])
  @@map("deployment_policies")
}
