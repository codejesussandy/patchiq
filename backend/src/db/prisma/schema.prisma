// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// User & Authentication Models
// ============================================

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  passwordHash  String    @map("password_hash")
  name          String?   @map("display_name")  // Keep for backwards compatibility
  firstName     String?   @map("first_name")    // NEW: Split name for frontend
  lastName      String?   @map("last_name")     // NEW: Split name for frontend
  contactNumber String?   @map("contact_number")
  timezone      String?   @default("UTC")       // NEW: User timezone preference
  avatar        String?                         // NEW: Avatar URL or path
  role          String    @default("user")
  isActive      Boolean   @default(true) @map("is_active")
  isOnboarded   Boolean   @default(false) @map("is_onboarded")
  lastLoginAt   DateTime? @map("last_login_at")
  deletedAt     DateTime? @map("deleted_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  // Relations
  organizationId String?       @map("organization_id")
  organization   Organization? @relation(fields: [organizationId], references: [id])
  departmentId   String?       @map("department_id")
  department     Department?   @relation(fields: [departmentId], references: [id])
  locationId     String?       @map("location_id")
  location       Location?     @relation(fields: [locationId], references: [id])

  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  auditLogs           AuditLog[]

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique @map("token_hash")
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique @map("token_hash")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("password_reset_tokens")
}

// ============================================
// Organization Structure Models
// ============================================

model Organization {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  isDefault   Boolean  @default(false) @map("is_default")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users    User[]
  branches Branch[]
  assets   Asset[]

  @@map("organizations")
}

model Branch {
  id             String       @id @default(uuid())
  name           String
  description    String?
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id])
  isDefault      Boolean      @default(false) @map("is_default")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  departments Department[]

  @@unique([organizationId, name])
  @@map("branches")
}

model Department {
  id          String   @id @default(uuid())
  name        String
  description String?
  branchId    String   @map("branch_id")
  branch      Branch   @relation(fields: [branchId], references: [id])
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users User[]

  @@unique([branchId, name])
  @@map("departments")
}

model Location {
  id        String   @id @default(uuid())
  name      String   @unique
  address   String?
  city      String?
  country   String?
  timezone  String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users  User[]
  assets Asset[]

  @@map("locations")
}

// ============================================
// Roles & Permissions Models
// ============================================

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  permissions Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("roles")
}

// ============================================
// Agent & Asset Models
// ============================================

model Agent {
  id                 String    @id @default(uuid())
  machineId          String    @unique @map("machine_id")
  name               String?
  hostname           String?
  status             String    @default("Pending")
  os                 String?
  osVersion          String?   @map("os_version")
  architecture       String?
  agentVersion       String?   @map("agent_version")
  ipAddress          String?   @map("ip_address")
  macAddress         String?   @map("mac_address")
  serialNumber       String?   @map("serial_number")
  lastHeartbeat      DateTime? @map("last_heartbeat")
  registeredAt       DateTime  @default(now()) @map("registered_at")
  tokenHash          String?   @map("token_hash")
  capabilities       Json      @default("[]")
  inventoryRequested Boolean   @default(false) @map("inventory_requested")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  assetId String? @unique @map("asset_id")
  asset   Asset?  @relation(fields: [assetId], references: [id])

  commands    AgentCommand[]
  telemetry   AgentTelemetry[]
  tags        AgentTagRelation[]
  groups      AgentGroupMembership[]

  @@index([status])
  @@map("agents")
}

model AgentCommand {
  id          String    @id @default(uuid())
  agentId     String    @map("agent_id")
  agent       Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  type        String
  payload     Json?
  status      String    @default("pending")
  result      Json?
  scheduledAt DateTime? @map("scheduled_at")
  executedAt  DateTime? @map("executed_at")
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([agentId, status])
  @@map("agent_commands")
}

model AgentTelemetry {
  id          String   @id @default(uuid())
  agentId     String   @map("agent_id")
  agent       Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)

  // Summary fields for quick queries and dashboards
  cpuUsage      Float?   @map("cpu_usage")
  memoryUsage   Float?   @map("memory_usage")
  diskUsage     Float?   @map("disk_usage")
  uptime        Int?
  networkInBps  BigInt?  @map("network_in_bps")   // NEW: Network bytes in per second
  networkOutBps BigInt?  @map("network_out_bps")  // NEW: Network bytes out per second
  processCount  Int?     @map("process_count")    // NEW: Running process count
  pendingReboot Boolean? @map("pending_reboot")   // NEW: System needs reboot

  // NEW: Full telemetry payload from agent
  rawPayload    Json?    @map("raw_payload")      // Stores complete Telemetry struct
  timestamp     DateTime @default(now())

  @@index([agentId, timestamp])
  @@map("agent_telemetry")
}

model AgentTagRelation {
  agentId String @map("agent_id")
  agent   Agent  @relation(fields: [agentId], references: [id], onDelete: Cascade)
  tag     String

  @@id([agentId, tag])
  @@map("agent_tags")
}

model AgentGroup {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  members AgentGroupMembership[]

  @@map("agent_groups")
}

model AgentGroupMembership {
  agentId String     @map("agent_id")
  agent   Agent      @relation(fields: [agentId], references: [id], onDelete: Cascade)
  groupId String     @map("group_id")
  group   AgentGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([agentId, groupId])
  @@map("agent_group_memberships")
}

model AgentDownload {
  id          String   @id @default(uuid())
  os          String
  version     String
  releaseDate DateTime @map("release_date")
  downloadUrl String   @map("download_url")
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([os, version])
  @@map("agent_downloads")
}

model AgentVersion {
  id          String   @id @default(uuid())
  platform    String
  architecture String
  version     String
  filePath    String?  @map("file_path")
  fileSize    BigInt?  @map("file_size")
  checksum    String?
  lastUpdatedAt DateTime @map("last_updated_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([platform, architecture, version])
  @@map("agent_versions")
}

model Asset {
  id             String       @id @default(uuid())
  name           String
  type           String       @default("Endpoint")
  status         String       @default("In Use")
  serialNumber   String?      @unique @map("serial_number")
  assetTag       String?      @unique @map("asset_tag")
  os             String?
  osVersion      String?      @map("os_version")
  ipAddress      String?      @map("ip_address")
  macAddress     String?      @map("mac_address")
  manufacturer   String?
  model          String?
  hostname       String?                         // NEW: Hostname from agent
  purchaseDate   DateTime?    @map("purchase_date")
  warrantyExpiry DateTime?    @map("warranty_expiry")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  // NEW: Owner information (denormalized for display)
  ownerId        String?      @map("owner_id")   // Optional FK to User
  ownerName      String?      @map("owner_name")
  ownerEmail     String?      @map("owner_email")
  ownerPhone     String?      @map("owner_phone")
  ownerDepartment String?     @map("owner_department")

  // NEW: Procurement fields (from MISMATCH_DECISIONS.md)
  vendor             String?                     // Vendor who sold the asset
  purchaseOrderNumber String?   @map("purchase_order_number")
  amcCost            String?    @map("amc_cost") // Annual Maintenance Contract cost
  amcExpiryDate      DateTime?  @map("amc_expiry_date")
  amcVendor          String?    @map("amc_vendor")
  endOfLife          DateTime?  @map("end_of_life")
  endOfSupport       DateTime?  @map("end_of_support")

  // NEW: Cost fields (from MISMATCH_DECISIONS.md)
  purchaseCost       Decimal?   @map("purchase_cost") @db.Decimal(12, 2)
  currentValue       Decimal?   @map("current_value") @db.Decimal(12, 2)
  salvageValue       Decimal?   @map("salvage_value") @db.Decimal(12, 2)
  currency           String?    @default("USD")
  depreciationType   String?    @map("depreciation_type") // "Straight Line" | "Declining Balance"
  depreciationRate   Decimal?   @map("depreciation_rate") @db.Decimal(5, 2)
  invoiceNumber      String?    @map("invoice_number")

  // NEW: Dual location support
  baseLocationId      String?   @map("base_location_id")
  installedLocationId String?   @map("installed_location_id")

  // Existing relations
  organizationId String?       @map("organization_id")
  organization   Organization? @relation(fields: [organizationId], references: [id])
  locationId     String?       @map("location_id")
  location       Location?     @relation(fields: [locationId], references: [id])

  agent             Agent?
  hardware          AssetHardware?
  software          AssetSoftware[]
  softwareInventory AssetSoftwareInventory?
  security          AssetSecurity?
  tags              AssetTag[]
  vulnerabilities   AssetVulnerability[]
  patchTasks        PatchDeploymentTask[]

  @@index([status])
  @@index([type])
  @@index([ownerId])
  @@map("assets")
}

model AssetHardware {
  id         String  @id @default(uuid())
  assetId    String  @unique @map("asset_id")
  asset      Asset   @relation(fields: [assetId], references: [id], onDelete: Cascade)

  // Summary fields for querying/display in lists (indexed)
  cpu             String?
  cpuCores        Int?     @map("cpu_cores")
  cpuManufacturer String?  @map("cpu_manufacturer")  // NEW: Intel, AMD, Apple
  cpuThreads      Int?     @map("cpu_threads")       // NEW: Thread count
  cpuSpeedMHz     Int?     @map("cpu_speed_mhz")     // NEW: Clock speed
  ramTotal        BigInt?  @map("ram_total")
  ramSlots        Int?     @map("ram_slots")         // NEW: Used memory slots
  ramType         String?  @map("ram_type")          // NEW: DDR4, DDR5
  diskTotal       BigInt?  @map("disk_total")
  diskFree        BigInt?  @map("disk_free")
  diskType        String?  @map("disk_type")         // NEW: SSD, HDD, NVMe
  gpuModel        String?  @map("gpu_model")
  gpuMemoryMB     Int?     @map("gpu_memory_mb")     // NEW: GPU memory
  biosVendor      String?  @map("bios_vendor")       // NEW: BIOS manufacturer
  biosVersion     String?  @map("bios_version")
  systemSKU       String?  @map("system_sku")
  manufacturer    String?                            // NEW: System manufacturer
  model           String?                            // NEW: System model
  serialNumber    String?  @map("serial_number")     // NEW: System serial

  // NEW: Full hardware payload from agent (JSON + Summary pattern)
  rawPayload      Json?    @map("raw_payload")       // Stores complete agent Hardware struct
  collectedAt     DateTime? @map("collected_at")     // When agent collected this data

  @@map("asset_hardware")
}

model AssetSoftware {
  id           String   @id @default(uuid())
  assetId      String   @map("asset_id")
  asset        Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  name         String
  version      String?
  vendor       String?
  installDate  DateTime? @map("install_date")
  installPath  String?   @map("install_path")
  isSystem     Boolean   @default(false) @map("is_system")
  category     String?                           // NEW: Application category

  @@index([assetId])
  @@map("asset_software")
}

// NEW: Complete software inventory from agent (includes OS info, services, etc.)
model AssetSoftwareInventory {
  id           String    @id @default(uuid())
  assetId      String    @unique @map("asset_id")
  asset        Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)

  // Summary fields for quick queries
  osName       String?   @map("os_name")
  osVersion    String?   @map("os_version")
  osBuild      String?   @map("os_build")
  totalApps    Int?      @map("total_apps")
  totalServices Int?     @map("total_services")

  // Full software inventory payload from agent
  rawPayload   Json?     @map("raw_payload")     // Stores complete SoftwareInventory struct
  collectedAt  DateTime? @map("collected_at")

  @@map("asset_software_inventory")
}

model AssetSecurity {
  id                  String    @id @default(uuid())
  assetId             String    @unique @map("asset_id")
  asset               Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  antivirusInstalled  Boolean?  @map("antivirus_installed")
  antivirusName       String?   @map("antivirus_name")
  antivirusUpdated    DateTime? @map("antivirus_updated")
  firewallEnabled     Boolean?  @map("firewall_enabled")
  encryptionEnabled   Boolean?  @map("encryption_enabled")
  lastSecurityScan    DateTime? @map("last_security_scan")
  complianceScore     Float?    @map("compliance_score")

  @@map("asset_security")
}

// ============================================
// Tag Models
// ============================================

model Tag {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  color       String?
  icon        String?
  priority    Int      @default(0)
  compliance  Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  assets AssetTag[]

  @@map("tags")
}

model AssetTag {
  assetId String @map("asset_id")
  asset   Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade)
  tagId   String @map("tag_id")
  tag     Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([assetId, tagId])
  @@map("asset_tags")
}

// ============================================
// Vulnerability Models
// ============================================

model Vulnerability {
  id                    String    @id @default(uuid())
  cveId                 String    @unique @map("cve_id")
  title                 String
  description           String?
  severity              String

  // CVSS Scores
  cvss3BaseScore        Float?    @map("cvss3_base_score")
  cvss2BaseScore        Float?    @map("cvss2_base_score")

  // CVSS3 Vector Details
  cvss3AttackVector     String?   @map("cvss3_attack_vector")
  cvss3AttackComplexity String?   @map("cvss3_attack_complexity")
  cvss3PrivilegesRequired String? @map("cvss3_privileges_required")
  cvss3Scope            String?   @map("cvss3_scope")
  cvss3Confidentiality  String?   @map("cvss3_confidentiality")
  cvss3Integrity        String?   @map("cvss3_integrity")
  cvss3Availability     String?   @map("cvss3_availability")
  cvss3ImpactScore      Float?    @map("cvss3_impact_score")
  cvss3VectorString     String?   @map("cvss3_vector_string")

  // CVSS2 Details (optional)
  cvss2Severity         String?   @map("cvss2_severity")

  // EPSS and Risk
  epss                  Float?    // Exploit Prediction Scoring System (0-100)
  riskScore             Float?    @map("risk_score")
  exploitable           Boolean   @default(false)
  isZeroDay             Boolean   @default(false) @map("is_zero_day")

  // Metadata
  publishedDate         DateTime? @map("published_date")
  lastModified          DateTime? @map("last_modified")
  patchAvailable        Boolean   @default(false) @map("patch_available")
  fixRecommendation     String?   @map("fix_recommendation")

  // MITRE ATT&CK
  mitreTactic           String?   @map("mitre_tactic")
  mitreTechnique        String?   @map("mitre_technique")
  mitreSubTechnique     String?   @map("mitre_sub_technique")
  mitreDescription      String?   @map("mitre_description")

  // Timestamps
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  // Relations
  affectedAssets        AssetVulnerability[]
  exceptions            VulnerabilityException[]
  references            VulnerabilityReference[]
  affectedSoftware      VulnerabilitySoftware[]

  @@index([severity])
  @@index([isZeroDay])
  @@index([publishedDate])
  @@index([riskScore])
  @@map("vulnerabilities")
}

model VulnerabilityReference {
  id              String        @id @default(uuid())
  vulnerabilityId String        @map("vulnerability_id")
  vulnerability   Vulnerability @relation(fields: [vulnerabilityId], references: [id], onDelete: Cascade)
  url             String
  source          String?

  @@map("vulnerability_references")
}

model VulnerabilitySoftware {
  id              String        @id @default(uuid())
  vulnerabilityId String        @map("vulnerability_id")
  vulnerability   Vulnerability @relation(fields: [vulnerabilityId], references: [id], onDelete: Cascade)
  name            String
  version         String?
  releaseVersion  String?       @map("release_version")
  fixedVersion    String?       @map("fixed_version")
  vendor          String?

  @@map("vulnerability_software")
}

model AssetVulnerability {
  id              String        @id @default(uuid())
  assetId         String        @map("asset_id")
  asset           Asset         @relation(fields: [assetId], references: [id], onDelete: Cascade)
  vulnerabilityId String        @map("vulnerability_id")
  vulnerability   Vulnerability @relation(fields: [vulnerabilityId], references: [id], onDelete: Cascade)
  status          String        @default("Open")
  detectedAt      DateTime      @default(now()) @map("detected_at")
  resolvedAt      DateTime?     @map("resolved_at")

  @@unique([assetId, vulnerabilityId])
  @@index([status])
  @@map("asset_vulnerabilities")
}

model VulnerabilityException {
  id                  String        @id @default(uuid())
  vulnerabilityId     String        @map("vulnerability_id")
  vulnerability       Vulnerability @relation(fields: [vulnerabilityId], references: [id], onDelete: Cascade)
  cve                 String
  exceptionType       String        @map("exception_type")
  reasonForExclusion  String?       @map("reason_for_exclusion")
  scope               String        @default("Global")
  source              String        @default("vulnerabilities") // 'vulnerabilities' | 'zeroDay'
  createdBy           String?       @map("created_by")
  createdAt           DateTime      @default(now()) @map("created_at")
  deletedAt           DateTime?     @map("deleted_at")

  // Relation to endpoints for scope-based exceptions
  endpoints           ExceptionEndpoint[]

  @@index([cve])
  @@map("vulnerability_exceptions")
}

model ExceptionEndpoint {
  id          String                 @id @default(uuid())
  exceptionId String                 @map("exception_id")
  exception   VulnerabilityException @relation(fields: [exceptionId], references: [id], onDelete: Cascade)
  endpointId  String                 @map("endpoint_id")

  @@unique([exceptionId, endpointId])
  @@map("exception_endpoints")
}

// ============================================
// Patch Models
// ============================================

model Patch {
  id                    String    @id @default(uuid())
  patchId               String    @unique @map("patch_id")
  title                 String
  software              String?
  description           String?
  severity              String
  category              String?
  vendor                String?
  product               String?
  os                    String?
  osVersion             String?   @map("os_version")
  platform              String?
  architecture          String?
  kbNumber              String?   @map("kb_number")
  bulletinId            String?   @map("bulletin_id")
  releaseDate           DateTime? @map("release_date")
  releasedOn            DateTime? @map("released_on")
  downloadedOn          DateTime? @map("downloaded_on")
  size                  BigInt?
  sizeFormatted         String?   @map("size_formatted")
  downloadUrl           String?   @map("download_url")
  referenceUrl          String?   @map("reference_url")
  rebootRequired        Boolean   @default(false) @map("reboot_required")
  supportUninstallation Boolean   @default(false) @map("support_uninstallation")
  languagesSupported    String[]  @default([]) @map("languages_supported")
  tags                  String[]  @default([])
  cveNumbers            String[]  @default([]) @map("cve_numbers")
  source                String?
  status                String?   @default("Draft")
  downloadStatus        String?   @default("None") @map("download_status")
  supersedes            String[]  @default([])
  supersededBy          String[]  @default([]) @map("superseded_by")
  operationalStatusSince DateTime? @map("operational_status_since")
  endpoints             Int       @default(0)

  // Test/Approval workflow fields
  testStatus            String    @default("Not Tested") @map("test_status")
  testResult            String?   @map("test_result")
  testedBy              String?   @map("tested_by")
  testedAt              DateTime? @map("tested_at")
  testNotes             String?   @map("test_notes")
  testEnvironment       String?   @map("test_environment")
  approvalStatus        String    @default("Pending") @map("approval_status")
  approvedBy            String?   @map("approved_by")
  approvedAt            DateTime? @map("approved_at")
  rejectedBy            String?   @map("rejected_by")
  rejectedAt            DateTime? @map("rejected_at")
  rejectionReason       String?   @map("rejection_reason")
  rejectionNotes        String?   @map("rejection_notes")

  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  deployments       PatchDeployment[]
  affectedProducts  PatchAffectedProduct[]
  fileDetails       PatchFileDetail[]
  vulnerabilities   PatchVulnerability[]
  patchEndpoints    PatchEndpoint[]

  @@index([severity])
  @@index([approvalStatus])
  @@index([testStatus])
  @@index([os])
  @@index([category])
  @@map("patches")
}

model PatchDeployment {
  id           String    @id @default(uuid())
  name         String
  deploymentId String?   @unique @map("deployment_id")
  description  String?
  type         String    @default("INSTANT")
  configType   String    @default("INSTALL") @map("config_type")
  scope        String    @default("Endpoint")
  status       String    @default("PENDING")
  stage        String    @default("IN_PROGRESS")
  pending      Int       @default(0)
  succeeded    Int       @default(0)
  failed       Int       @default(0)
  targetGroups String[]  @default([]) @map("target_groups")
  scheduledAt  DateTime? @map("scheduled_at")
  startedAt    DateTime? @map("started_at")
  completedAt  DateTime? @map("completed_at")
  createdBy    String?   @map("created_by")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  patches Patch[]
  tasks   PatchDeploymentTask[]

  @@index([status])
  @@index([stage])
  @@map("patch_deployments")
}

model PatchDeploymentTask {
  id           String          @id @default(uuid())
  deploymentId String          @map("deployment_id")
  deployment   PatchDeployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)
  assetId      String          @map("asset_id")
  asset        Asset           @relation(fields: [assetId], references: [id])
  status       String          @default("pending")
  startedAt    DateTime?       @map("started_at")
  completedAt  DateTime?       @map("completed_at")
  errorMessage String?         @map("error_message")

  @@index([deploymentId, status])
  @@map("patch_deployment_tasks")
}

model PatchAffectedProduct {
  id           String  @id @default(uuid())
  patchId      String  @map("patch_id")
  patch        Patch   @relation(fields: [patchId], references: [id], onDelete: Cascade)
  softwareName String  @map("software_name")
  version      String?
  vendor       String?
  installedOn  Int     @default(0) @map("installed_on")
  platform     String?

  @@index([patchId])
  @@map("patch_affected_products")
}

model PatchFileDetail {
  id              String    @id @default(uuid())
  patchId         String    @map("patch_id")
  patch           Patch     @relation(fields: [patchId], references: [id], onDelete: Cascade)
  fileName        String    @map("file_name")
  version         String?
  size            String?
  sizeBytes       BigInt?   @map("size_bytes")
  path            String?
  // MinIO storage fields
  minioObjectKey  String?   @map("minio_object_key")   // e.g., "windows/microsoft/KB5034441/x64/patch.msu"
  minioBucket     String?   @map("minio_bucket")        // e.g., "patches"
  checksum        String?                               // SHA256 hash
  checksumType    String?   @map("checksum_type")       // "sha256" | "md5"
  sourceUrl       String?   @map("source_url")          // Original vendor URL
  downloadStatus  String    @default("pending") @map("download_status") // pending | downloading | completed | failed
  downloadedAt    DateTime? @map("downloaded_at")
  downloadError   String?   @map("download_error")
  retryCount      Int       @default(0) @map("retry_count")

  @@index([patchId])
  @@index([downloadStatus])
  @@index([minioObjectKey])
  @@map("patch_file_details")
}

// ============================================
// Patch Repository Models (Central Patch Storage)
// ============================================

model PatchSource {
  id              String    @id @default(uuid())
  name            String                              // e.g., "Microsoft Windows Update"
  vendor          String                              // e.g., "Microsoft", "Apple", "Adobe"
  category        String                              // "os", "firmware", "enterprise", "runtime", "security", "browser", "utility"
  platform        String?                             // "windows", "macos", "linux", "cross-platform"
  baseUrl         String    @map("base_url")          // e.g., "https://download.windowsupdate.com"
  urlPatterns     String[]  @default([]) @map("url_patterns") // Glob patterns for allowed URLs
  priority        Int       @default(50)              // 1-100, higher = more important
  isEnabled       Boolean   @default(true) @map("is_enabled")
  requiresAuth    Boolean   @default(false) @map("requires_auth")
  authType        String?   @map("auth_type")         // "basic", "bearer", "api_key"
  authConfig      Json?     @map("auth_config")       // Encrypted auth configuration
  syncSchedule    String?   @map("sync_schedule")     // Cron expression for scheduled sync
  lastSyncAt      DateTime? @map("last_sync_at")
  lastSyncStatus  String?   @map("last_sync_status")  // "success", "partial", "failed"
  lastSyncError   String?   @map("last_sync_error")
  metadata        Json?                               // Additional vendor-specific config
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  downloadJobs    PatchDownloadJob[]

  @@unique([vendor, name])
  @@index([vendor])
  @@index([category])
  @@index([isEnabled])
  @@map("patch_sources")
}

model PatchDownloadJob {
  id              String    @id @default(uuid())
  jobId           String    @unique @map("job_id")    // BullMQ job ID for tracking
  sourceId        String?   @map("source_id")
  source          PatchSource? @relation(fields: [sourceId], references: [id])
  patchId         String?   @map("patch_id")          // Link to Patch if known
  sourceUrl       String    @map("source_url")        // URL to download from
  targetPath      String    @map("target_path")       // MinIO object key target
  fileName        String    @map("file_name")
  expectedSize    BigInt?   @map("expected_size")
  expectedChecksum String?  @map("expected_checksum")
  checksumType    String?   @map("checksum_type")
  status          String    @default("pending")       // pending | queued | downloading | verifying | completed | failed | cancelled
  progress        Int       @default(0)               // 0-100 percentage
  downloadedBytes BigInt?   @map("downloaded_bytes")
  actualChecksum  String?   @map("actual_checksum")
  error           String?
  retryCount      Int       @default(0) @map("retry_count")
  maxRetries      Int       @default(3) @map("max_retries")
  priority        Int       @default(50)              // 1-100
  startedAt       DateTime? @map("started_at")
  completedAt     DateTime? @map("completed_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([status])
  @@index([sourceId])
  @@index([patchId])
  @@index([priority])
  @@map("patch_download_jobs")
}

model PatchVulnerability {
  id            String    @id @default(uuid())
  patchId       String    @map("patch_id")
  patch         Patch     @relation(fields: [patchId], references: [id], onDelete: Cascade)
  cveNumber     String    @map("cve_number")
