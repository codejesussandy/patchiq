# Server
NODE_ENV=development
PORT=3000
API_VERSION=v1
CORS_ORIGIN=http://localhost:6001

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:6003/patchiq_dev

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=debug

# Session Settings
SESSION_ABSOLUTE_TIMEOUT_HOURS=8
SESSION_IDLE_TIMEOUT_MINUTES=30

# External Services (Mock by default in development)
USE_MOCK_NVD=true
USE_MOCK_EMAIL=true
USE_MOCK_LDAP=true
USE_MOCK_PATCHES=true

# NIST NVD API (optional, for real integration)
NIST_NVD_API_KEY=

# SMTP Configuration (optional, for real integration)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@patchiq.io

# LDAP Configuration (optional, for real integration)
LDAP_HOST=
LDAP_PORT=389
LDAP_BASE_DN=
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=

# Encryption Key (for sensitive data encryption)
ENCRYPTION_KEY=your-32-byte-encryption-key-here

# Redis (for BullMQ job queue)
REDIS_URL=redis://localhost:6004

# Backend Public URL (for agent downloads - agents connect to this address)
# Format: http://domain-or-ip:port (the agent will add /api/agent/... paths)
BACKEND_PUBLIC_URL=http://localhost:6001

# MinIO Configuration (S3-compatible patch storage)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=patchiq_admin
MINIO_SECRET_KEY=patchiq_secret_key
MINIO_BUCKET=patches
MINIO_USE_SSL=false
# Public MinIO endpoint for agents outside Docker network (optional)
# MINIO_PUBLIC_ENDPOINT=your-server-ip
# MINIO_PUBLIC_PORT=5001
