# PatchIQ Backend Environment
# ============================
# Copy to .env — all vars have sensible defaults in env.ts except DATABASE_URL and JWT_SECRET.

# Server
NODE_ENV=development
PORT=5002
API_VERSION=v1
CORS_ORIGIN=http://localhost:5001

# Database (standard PostgreSQL port — Docker exposes 5432 via POSTGRES_PORT)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/patchiq_dev

# JWT (must be 32+ chars)
JWT_SECRET=dev-jwt-secret-change-in-production-32chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Redis (standard port — Docker exposes 6379 via REDIS_PORT)
REDIS_URL=redis://localhost:6379

# MinIO (standard port — Docker exposes 9000 via MINIO_PORT)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=patchiq_admin
MINIO_SECRET_KEY=patchiq_secret_key
MINIO_BUCKET=patches
MINIO_USE_SSL=false

# Backend public URL (agents connect to this address)
BACKEND_PUBLIC_URL=http://localhost:5002

# Encryption key (32+ chars, optional)
ENCRYPTION_KEY=dev-32-byte-encryption-key-here!!

# External services (all mocked by default in development)
USE_MOCK_NVD=true
USE_MOCK_EMAIL=true
USE_MOCK_LDAP=true
USE_MOCK_PATCHES=true
