# Server
NODE_ENV=development
PORT=3000
API_VERSION=v1
CORS_ORIGIN=http://localhost:5173

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/patchiq_dev

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=debug

# Session Settings
SESSION_ABSOLUTE_TIMEOUT_HOURS=8
SESSION_IDLE_TIMEOUT_MINUTES=30

# External Services (Mock by default in development)
USE_MOCK_NVD=true
USE_MOCK_EMAIL=true
USE_MOCK_LDAP=true
USE_MOCK_PATCHES=true

# NIST NVD API (optional, for real integration)
NIST_NVD_API_KEY=

# SMTP Configuration (optional, for real integration)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@patchiq.io

# LDAP Configuration (optional, for real integration)
LDAP_HOST=
LDAP_PORT=389
LDAP_BASE_DN=
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=

# Encryption Key (for sensitive data encryption)
ENCRYPTION_KEY=your-32-byte-encryption-key-here
