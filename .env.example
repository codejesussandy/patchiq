# PatchIQ Environment Configuration
# ==================================
# Copy this file to .env and adjust values for your environment.
# docker-compose.yml and Makefile read these variables automatically.
#
# DEPLOYMENT GUIDE:
#   1. Copy this file:  cp .env.example .env
#   2. Set PUBLIC_HOST to your server's domain or IP
#   3. Change JWT_SECRET for production
#   4. Run: make dev

# ── Public Access ─────────────────────────────────────────────
# How external devices (browsers, agents) reach this server.
# These three variables drive ALL public URLs in the platform.
PUBLIC_SCHEME=http
PUBLIC_HOST=localhost
PUBLIC_PORT=3001

# ── Security ──────────────────────────────────────────────────
# MUST change for production deployments
JWT_SECRET=dev-jwt-secret-change-in-production

# ── Service Ports (external host mappings) ────────────────────
# These are the ports exposed on the HOST machine.
# Internal Docker ports are fixed and not configurable.
#
#   Service         External   Internal (Docker)   Purpose
#   ─────────────   ────────   ─────────────────   ──────────────────
#   Main Entry      3001       80  (nginx)         Frontend + API
#   PostgreSQL      3002       5432                 Database
#   Redis           3003       6379                 Job queue
#   pgAdmin         3004       80                   DB admin UI
#   Prisma Studio   3005       5555                 DB schema UI
#   Agent WebUI     3006       (native binary)      Agent local UI
#   Backend         3007       3000                 Direct debug access
#   MinIO S3 API    3008       9000                 Patch storage
#   MinIO Console   3009       9001                 Storage admin UI

POSTGRES_EXTERNAL_PORT=3002
REDIS_EXTERNAL_PORT=3003
PGADMIN_PORT=3004
PRISMA_STUDIO_PORT=3005
AGENT_WEBUI_PORT=3006
BACKEND_PORT=3007
MINIO_PORT=3008
MINIO_CONSOLE_PORT=3009

# ── Frontend Dev ──────────────────────────────────────────────
# HMR (Hot Module Replacement) host for Vite dev server.
# Set to PUBLIC_HOST when developing remotely.
HMR_HOST=localhost

# ── Agent Build ───────────────────────────────────────────────
# URL embedded into agent binary at compile time.
# Must match PUBLIC_SCHEME://PUBLIC_HOST:PUBLIC_PORT/api
PATCHIQ_SERVER_URL=http://localhost:3001/api

# ── Agent Runtime (optional) ──────────────────────────────────
# Override agent WebUI port when running outside Docker
# PATCHIQ_WEBUI_PORT=3006
