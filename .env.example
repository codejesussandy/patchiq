# PatchIQ Environment Configuration
# ==================================
# Copy this file to .env and adjust values for your environment.
# docker-compose.yml reads these variables automatically.
#
# The three PUBLIC_* vars below are the ONLY settings you need to change
# when deploying to a new server or network. Everything else derives from them.

# Public-facing address (how external devices reach this server)
PUBLIC_SCHEME=http
PUBLIC_HOST=dev.skenzeriq.com
PUBLIC_PORT=5173

# JWT secret (MUST change for production)
JWT_SECRET=dev-jwt-secret-change-in-production

# Agent environment variables (for running agent outside Docker)
# PATCHIQ_SERVER_URL=http://dev.skenzeriq.com:5173/api
# PATCHIQ_WEBUI_PORT=8080
