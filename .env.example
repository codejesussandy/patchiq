# PatchIQ Environment Configuration
# ==================================
# Copy this file to .env and adjust values for your environment.
# docker-compose.yml reads these variables automatically.
#
# The three PUBLIC_* vars below are the ONLY settings you need to change
# when deploying to a new server or network. Everything else derives from them.

# Public-facing address (how external devices reach this server)
PUBLIC_SCHEME=http
PUBLIC_HOST=dev.skenzeriq.com
PUBLIC_PORT=6001

# JWT secret (MUST change for production)
JWT_SECRET=dev-jwt-secret-change-in-production

# Service port mappings (external:internal)
# Staging uses 6001-6010 range to avoid conflicts with development
POSTGRES_EXTERNAL_PORT=6003
REDIS_EXTERNAL_PORT=6004
PGADMIN_PORT=6005
PRISMA_STUDIO_PORT=6006
AGENT_WEBUI_PORT=6007

# Agent build configuration (used when building agent binaries)
# This URL is embedded into the agent binary at compile time
PATCHIQ_SERVER_URL=http://dev.skenzeriq.com:6001/api

# Agent runtime environment variables (for running agent outside Docker)
# PATCHIQ_WEBUI_PORT=6007
