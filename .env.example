# PatchIQ Environment Configuration
# ==================================
# Copy this file to .env and adjust values for your environment.
# docker-compose.yml and Makefile read these variables automatically.
#
# DEPLOYMENT GUIDE:
#   1. Copy this file:  cp .env.example .env
#   2. Set PUBLIC_HOST to your server's domain or IP
#   3. Set PUBLIC_PORT to your desired entry point (must be forwarded)
#   4. Adjust service ports if needed (must be reachable/forwarded)
#   5. Change JWT_SECRET for production
#   6. Run: make dev

# ── Public Access ─────────────────────────────────────────────
# How external devices (browsers, agents) reach this server.
# These three variables drive ALL public URLs in the platform.
PUBLIC_SCHEME=http
PUBLIC_HOST=dev.skenzeriq.com
PUBLIC_PORT=3500

# ── Security ──────────────────────────────────────────────────
# MUST change for production deployments
JWT_SECRET=dev-jwt-secret-change-in-production

# ── Service Ports (external host mappings) ────────────────────
# These are the ports exposed on the HOST machine.
# Internal Docker ports are fixed and not configurable.
#
#   Service         External   Internal (Docker)   Purpose
#   ─────────────   ────────   ─────────────────   ──────────────────
#   Main Entry      3500       80  (nginx)         Frontend + API
#   PostgreSQL      4500       5432                 Database
#   Redis           4501       6379                 Job queue
#   pgAdmin         4502       80                   DB admin UI
#   Prisma Studio   4503       5555                 DB schema UI
#   Agent WebUI     4504       (native binary)      Agent local UI

POSTGRES_EXTERNAL_PORT=4500
REDIS_EXTERNAL_PORT=4501
PGADMIN_PORT=4502
PRISMA_STUDIO_PORT=4503
AGENT_WEBUI_PORT=4504

# ── Frontend Dev ──────────────────────────────────────────────
# HMR (Hot Module Replacement) host for Vite dev server.
# Set to PUBLIC_HOST when developing remotely.
HMR_HOST=localhost

# ── Agent Build ───────────────────────────────────────────────
# URL embedded into agent binary at compile time.
# Must match PUBLIC_SCHEME://PUBLIC_HOST:PUBLIC_PORT/api
PATCHIQ_SERVER_URL=http://dev.skenzeriq.com:3500/api

# ── Agent Runtime (optional) ──────────────────────────────────
# Override agent WebUI port when running outside Docker
# PATCHIQ_WEBUI_PORT=4504
