{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://patchify.io/schemas/peripheral.json",
  "title": "Peripherals",
  "description": "Peripheral devices data collected by agents",
  "type": "object",
  "definitions": {
    "Monitor": {
      "type": "object",
      "description": "Connected monitor/display",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string",
          "description": "Monitor name/model",
          "examples": ["Dell U2723QE", "LG 27UK850", "Built-in Retina Display"]
        },
        "manufacturer": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "serialNumber": {
          "type": "string"
        },
        "connectionType": {
          "type": "string",
          "enum": ["HDMI", "DisplayPort", "USB-C", "Thunderbolt", "VGA", "DVI", "Internal", "Unknown"],
          "description": "Connection interface"
        },
        "resolution": {
          "type": "string",
          "description": "Current resolution",
          "examples": ["3840x2160", "2560x1440", "1920x1080"]
        },
        "nativeResolution": {
          "type": "string",
          "description": "Native/maximum resolution"
        },
        "refreshRate": {
          "type": "integer",
          "description": "Refresh rate in Hz"
        },
        "screenSizeInches": {
          "type": "number",
          "description": "Diagonal screen size in inches"
        },
        "physicalWidthMm": {
          "type": "integer"
        },
        "physicalHeightMm": {
          "type": "integer"
        },
        "bitDepth": {
          "type": "integer",
          "description": "Color depth in bits"
        },
        "isPrimary": {
          "type": "boolean",
          "description": "Whether this is the primary display"
        },
        "isBuiltIn": {
          "type": "boolean",
          "description": "Whether this is a built-in display"
        },
        "scalingPercent": {
          "type": "integer",
          "description": "Display scaling percentage"
        },
        "orientation": {
          "type": "string",
          "enum": ["Landscape", "Portrait", "LandscapeFlipped", "PortraitFlipped"]
        },
        "yearOfManufacture": {
          "type": "integer"
        },
        "weekOfManufacture": {
          "type": "integer"
        }
      }
    },
    "USBDevice": {
      "type": "object",
      "description": "Connected USB device",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string",
          "description": "Device name"
        },
        "manufacturer": {
          "type": "string"
        },
        "productId": {
          "type": "string",
          "description": "USB Product ID (hex)"
        },
        "vendorId": {
          "type": "string",
          "description": "USB Vendor ID (hex)"
        },
        "serialNumber": {
          "type": "string"
        },
        "deviceClass": {
          "type": "string",
          "enum": ["HID", "MassStorage", "Audio", "Video", "Printer", "Hub", "Communications", "SmartCard", "Wireless", "Other"],
          "description": "USB device class"
        },
        "deviceType": {
          "type": "string",
          "description": "Human-readable device type",
          "examples": ["Keyboard", "Mouse", "USB Flash Drive", "Webcam", "Headset"]
        },
        "usbVersion": {
          "type": "string",
          "enum": ["1.0", "1.1", "2.0", "3.0", "3.1", "3.2", "4.0", "Unknown"],
          "description": "USB protocol version"
        },
        "speed": {
          "type": "string",
          "enum": ["Low", "Full", "High", "Super", "SuperPlus", "Unknown"],
          "description": "USB speed grade"
        },
        "portNumber": {
          "type": "integer"
        },
        "hubPort": {
          "type": "string",
          "description": "Hub and port path"
        },
        "isHub": {
          "type": "boolean"
        },
        "currentDrawMa": {
          "type": "integer",
          "description": "Current draw in milliamps"
        },
        "driverName": {
          "type": "string"
        },
        "driverVersion": {
          "type": "string"
        },
        "isRemovable": {
          "type": "boolean"
        },
        "connectedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "DockingStation": {
      "type": "object",
      "description": "Connected docking station",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string",
          "examples": ["Dell WD19TBS", "Lenovo ThinkPad USB-C Dock", "CalDigit TS4"]
        },
        "manufacturer": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "serialNumber": {
          "type": "string"
        },
        "firmwareVersion": {
          "type": "string"
        },
        "connectionType": {
          "type": "string",
          "enum": ["Thunderbolt", "USB-C", "USB-A", "Proprietary"],
          "description": "Connection to host"
        },
        "powerDeliveryWatts": {
          "type": "integer",
          "description": "Power delivery capability in watts"
        },
        "connectedDevices": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Devices connected through dock"
        },
        "availablePorts": {
          "type": "object",
          "properties": {
            "usb_a": { "type": "integer" },
            "usb_c": { "type": "integer" },
            "thunderbolt": { "type": "integer" },
            "hdmi": { "type": "integer" },
            "displayPort": { "type": "integer" },
            "ethernet": { "type": "integer" },
            "audio": { "type": "integer" },
            "sdCard": { "type": "integer" }
          }
        }
      }
    },
    "Printer": {
      "type": "object",
      "description": "Connected or network printer",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "driverName": {
          "type": "string"
        },
        "portName": {
          "type": "string"
        },
        "connectionType": {
          "type": "string",
          "enum": ["USB", "Network", "Bluetooth", "WiFi", "Shared", "Virtual"],
          "description": "Connection type"
        },
        "ipAddress": {
          "type": "string",
          "description": "IP address for network printers"
        },
        "status": {
          "type": "string",
          "enum": ["Ready", "Offline", "Error", "Busy", "PaperJam", "LowToner", "Unknown"]
        },
        "isDefault": {
          "type": "boolean"
        },
        "isShared": {
          "type": "boolean"
        },
        "isNetwork": {
          "type": "boolean"
        },
        "manufacturer": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "serialNumber": {
          "type": "string"
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["Print", "Scan", "Copy", "Fax", "Duplex", "Color"]
          }
        }
      }
    },
    "AudioDevice": {
      "type": "object",
      "description": "Audio input/output device",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "enum": ["Output", "Input", "Both"]
        },
        "deviceType": {
          "type": "string",
          "enum": ["Speaker", "Headphones", "Microphone", "Headset", "LineIn", "LineOut", "HDMI", "DisplayPort", "Bluetooth", "USB", "Built-in", "Unknown"]
        },
        "isDefault": {
          "type": "boolean"
        },
        "isEnabled": {
          "type": "boolean"
        },
        "manufacturer": {
          "type": "string"
        },
        "driverVersion": {
          "type": "string"
        },
        "connectionType": {
          "type": "string",
          "enum": ["Internal", "USB", "Bluetooth", "HDMI", "Jack", "Unknown"]
        },
        "sampleRate": {
          "type": "integer",
          "description": "Sample rate in Hz"
        },
        "bitDepth": {
          "type": "integer"
        },
        "channels": {
          "type": "integer"
        }
      }
    },
    "BluetoothDevice": {
      "type": "object",
      "description": "Paired Bluetooth device",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "address": {
          "type": "string",
          "description": "Bluetooth MAC address"
        },
        "type": {
          "type": "string",
          "enum": ["Keyboard", "Mouse", "Headphones", "Speaker", "Phone", "Tablet", "Computer", "Gamepad", "Other"]
        },
        "connected": {
          "type": "boolean"
        },
        "paired": {
          "type": "boolean"
        },
        "batteryLevel": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "description": "Battery level if supported"
        },
        "manufacturer": {
          "type": "string"
        },
        "lastConnected": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "PeripheralInventory": {
      "type": "object",
      "description": "Complete peripheral inventory",
      "required": ["collectedAt"],
      "properties": {
        "collectedAt": {
          "type": "string",
          "format": "date-time"
        },
        "monitors": {
          "type": "array",
          "items": { "$ref": "#/definitions/Monitor" }
        },
        "monitorCount": {
          "type": "integer"
        },
        "usbDevices": {
          "type": "array",
          "items": { "$ref": "#/definitions/USBDevice" }
        },
        "usbDeviceCount": {
          "type": "integer"
        },
        "dockingStations": {
          "type": "array",
          "items": { "$ref": "#/definitions/DockingStation" }
        },
        "printers": {
          "type": "array",
          "items": { "$ref": "#/definitions/Printer" }
        },
        "audioDevices": {
          "type": "array",
          "items": { "$ref": "#/definitions/AudioDevice" }
        },
        "bluetoothDevices": {
          "type": "array",
          "items": { "$ref": "#/definitions/BluetoothDevice" }
        },
        "bluetoothEnabled": {
          "type": "boolean"
        },
        "webcams": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "manufacturer": { "type": "string" },
              "resolution": { "type": "string" },
              "isBuiltIn": { "type": "boolean" }
            }
          }
        }
      }
    }
  },
  "$ref": "#/definitions/PeripheralInventory"
}
