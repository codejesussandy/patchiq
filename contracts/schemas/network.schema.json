{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://patchify.io/schemas/network.json",
  "title": "Network Configuration",
  "description": "Network configuration and connectivity data collected by agents",
  "type": "object",
  "definitions": {
    "NetworkIdentity": {
      "type": "object",
      "description": "Network identity information",
      "required": ["hostname"],
      "properties": {
        "hostname": {
          "type": "string",
          "description": "System hostname"
        },
        "fqdn": {
          "type": "string",
          "description": "Fully Qualified Domain Name"
        },
        "domainName": {
          "type": "string",
          "description": "Domain name if domain-joined"
        },
        "workgroup": {
          "type": "string",
          "description": "Workgroup name if not domain-joined"
        },
        "isDomainJoined": {
          "type": "boolean"
        },
        "domainRole": {
          "type": "string",
          "enum": ["StandaloneWorkstation", "MemberWorkstation", "StandaloneServer", "MemberServer", "BackupDomainController", "PrimaryDomainController"],
          "description": "Domain role (Windows)"
        }
      }
    },
    "IPConfiguration": {
      "type": "object",
      "description": "IP address configuration",
      "properties": {
        "ipv4Address": {
          "type": "string",
          "format": "ipv4"
        },
        "ipv4SubnetMask": {
          "type": "string",
          "format": "ipv4",
          "examples": ["255.255.255.0", "255.255.0.0"]
        },
        "ipv4Gateway": {
          "type": "string",
          "format": "ipv4"
        },
        "ipv6Address": {
          "type": "string",
          "format": "ipv6"
        },
        "ipv6PrefixLength": {
          "type": "integer",
          "minimum": 0,
          "maximum": 128
        },
        "ipv6Gateway": {
          "type": "string",
          "format": "ipv6"
        },
        "dhcpEnabled": {
          "type": "boolean"
        },
        "dhcpServer": {
          "type": "string",
          "format": "ipv4"
        },
        "dhcpLeaseObtained": {
          "type": "string",
          "format": "date-time"
        },
        "dhcpLeaseExpires": {
          "type": "string",
          "format": "date-time"
        },
        "dnsServers": {
          "type": "array",
          "items": { "type": "string" },
          "description": "List of DNS server addresses"
        },
        "dnsSuffix": {
          "type": "string"
        },
        "winsServers": {
          "type": "array",
          "items": { "type": "string" },
          "description": "WINS servers (Windows)"
        }
      }
    },
    "NetworkAdapter": {
      "type": "object",
      "description": "Network adapter/interface information",
      "required": ["name", "type", "macAddress"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for this adapter"
        },
        "name": {
          "type": "string",
          "description": "Adapter name",
          "examples": ["Ethernet", "Wi-Fi", "en0", "eth0"]
        },
        "description": {
          "type": "string",
          "description": "Full adapter description",
          "examples": ["Intel(R) Wi-Fi 6 AX201 160MHz", "Realtek PCIe GbE Family Controller"]
        },
        "type": {
          "type": "string",
          "enum": ["Ethernet", "WiFi", "Virtual", "Loopback", "Bluetooth", "VPN", "Bridge", "Unknown"],
          "description": "Adapter type"
        },
        "macAddress": {
          "type": "string",
          "pattern": "^([0-9A-Fa-f]{2}[:-]){5}([0-9A-Fa-f]{2})$",
          "description": "MAC address"
        },
        "status": {
          "type": "string",
          "enum": ["Up", "Down", "Disconnected", "Unknown"],
          "description": "Link status"
        },
        "speedMbps": {
          "type": "integer",
          "description": "Link speed in Mbps"
        },
        "mtu": {
          "type": "integer",
          "description": "Maximum transmission unit"
        },
        "ipConfiguration": {
          "$ref": "#/definitions/IPConfiguration"
        },
        "driverVersion": {
          "type": "string"
        },
        "driverDate": {
          "type": "string",
          "format": "date"
        },
        "manufacturer": {
          "type": "string"
        },
        "isPhysical": {
          "type": "boolean",
          "description": "Whether this is a physical adapter"
        },
        "isEnabled": {
          "type": "boolean"
        }
      }
    },
    "WiFiConnection": {
      "type": "object",
      "description": "Wi-Fi connection details",
      "properties": {
        "ssid": {
          "type": "string",
          "description": "Connected network SSID"
        },
        "bssid": {
          "type": "string",
          "description": "Access point MAC address"
        },
        "signalStrength": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "description": "Signal strength percentage"
        },
        "rssi": {
          "type": "integer",
          "description": "RSSI in dBm (typically -30 to -90)"
        },
        "noiseLevel": {
          "type": "integer",
          "description": "Noise level in dBm"
        },
        "channel": {
          "type": "integer",
          "description": "Wi-Fi channel number"
        },
        "frequency": {
          "type": "number",
          "description": "Frequency in GHz",
          "examples": [2.4, 5.0, 6.0]
        },
        "band": {
          "type": "string",
          "enum": ["2.4GHz", "5GHz", "6GHz"],
          "description": "Frequency band"
        },
        "securityType": {
          "type": "string",
          "enum": ["Open", "WEP", "WPA", "WPA2", "WPA3", "WPA2-Enterprise", "WPA3-Enterprise", "Unknown"],
          "description": "Security protocol"
        },
        "authentication": {
          "type": "string",
          "enum": ["Open", "PSK", "EAP", "SAE", "Unknown"],
          "description": "Authentication type"
        },
        "encryption": {
          "type": "string",
          "enum": ["None", "WEP", "TKIP", "CCMP", "GCMP", "Unknown"],
          "description": "Encryption type"
        },
        "linkSpeed": {
          "type": "string",
          "description": "Connection speed",
          "examples": ["866 Mbps", "1200 Mbps"]
        },
        "protocol": {
          "type": "string",
          "enum": ["802.11a", "802.11b", "802.11g", "802.11n", "802.11ac", "802.11ax", "802.11be"],
          "description": "Wi-Fi standard"
        },
        "profileName": {
          "type": "string",
          "description": "Saved profile name"
        }
      }
    },
    "NetworkConfiguration": {
      "type": "object",
      "description": "Complete network configuration",
      "required": ["collectedAt", "identity", "adapters"],
      "properties": {
        "collectedAt": {
          "type": "string",
          "format": "date-time"
        },
        "identity": {
          "$ref": "#/definitions/NetworkIdentity"
        },
        "adapters": {
          "type": "array",
          "items": { "$ref": "#/definitions/NetworkAdapter" },
          "description": "All network adapters"
        },
        "primaryAdapter": {
          "type": "string",
          "description": "ID of primary network adapter"
        },
        "wifiConnection": {
          "$ref": "#/definitions/WiFiConnection"
        },
        "publicIpAddress": {
          "type": "string",
          "description": "External/public IP address (if detectable)"
        },
        "vpnConnected": {
          "type": "boolean",
          "description": "Whether VPN connection is active"
        },
        "vpnName": {
          "type": "string",
          "description": "Active VPN connection name"
        },
        "proxyConfigured": {
          "type": "boolean"
        },
        "proxyServer": {
          "type": "string"
        },
        "proxyPort": {
          "type": "integer"
        }
      }
    }
  },
  "$ref": "#/definitions/NetworkConfiguration"
}
