{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://patchify.io/schemas/agent.json",
  "title": "Agent",
  "description": "Schema for the Patchify endpoint agent client",
  "type": "object",
  "definitions": {
    "AgentStatus": {
      "type": "string",
      "enum": ["Connected", "Disconnected", "Pending", "Error"],
      "description": "Current connection status of the agent"
    },
    "OSFamily": {
      "type": "string",
      "enum": ["Windows", "MacOS", "Linux"],
      "description": "Operating system family"
    },
    "Agent": {
      "type": "object",
      "description": "Registered agent instance",
      "required": ["id", "machineId", "name", "status", "os", "osVersion", "agentVersion", "lastHeartbeat", "registeredAt"],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "description": "Unique identifier assigned by backend"
        },
        "machineId": {
          "type": "string",
          "description": "Unique machine identifier (hardware UUID or generated)",
          "minLength": 16
        },
        "name": {
          "type": "string",
          "description": "Human-readable name (hostname or custom)",
          "maxLength": 255
        },
        "status": {
          "$ref": "#/definitions/AgentStatus"
        },
        "os": {
          "$ref": "#/definitions/OSFamily"
        },
        "osVersion": {
          "type": "string",
          "description": "Full OS version string",
          "examples": ["Windows 11 Pro 23H2", "macOS 14.2 Sonoma", "Ubuntu 22.04 LTS"]
        },
        "agentVersion": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+(-[a-zA-Z0-9]+)?$",
          "description": "Agent software version (semver)",
          "examples": ["1.0.0", "1.2.3-beta"]
        },
        "lastHeartbeat": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 timestamp of last heartbeat"
        },
        "lastHeartbeatRelative": {
          "type": "string",
          "description": "Human-readable relative time (computed by backend)",
          "examples": ["2 minutes ago", "Just now", "5 hours ago"]
        },
        "registeredAt": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 timestamp of initial registration"
        },
        "ipAddress": {
          "type": "string",
          "format": "ipv4",
          "description": "Primary IP address of the agent"
        },
        "hostname": {
          "type": "string",
          "description": "System hostname"
        },
        "serialNumber": {
          "type": "string",
          "description": "Hardware serial number"
        },
        "assetId": {
          "type": "string",
          "format": "uuid",
          "description": "Linked asset ID (if asset exists)"
        },
        "tags": {
          "type": "array",
          "items": { "type": "string" },
          "description": "User-assigned tags for grouping"
        },
        "groups": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" }
            }
          },
          "description": "Endpoint groups this agent belongs to"
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "inventory_hardware",
              "inventory_software",
              "inventory_network",
              "inventory_security",
              "telemetry",
              "patch_scan",
              "patch_install",
              "patch_rollback",
              "remote_command",
              "file_transfer"
            ]
          },
          "description": "Agent capabilities based on OS and permissions"
        },
        "config": {
          "$ref": "#/definitions/AgentConfig"
        }
      }
    },
    "AgentConfig": {
      "type": "object",
      "description": "Agent configuration pushed by backend",
      "properties": {
        "heartbeatIntervalSeconds": {
          "type": "integer",
          "minimum": 10,
          "maximum": 3600,
          "default": 60,
          "description": "How often agent sends heartbeat"
        },
        "inventoryScheduleCron": {
          "type": "string",
          "description": "Cron expression for full inventory collection",
          "examples": ["0 */6 * * *", "0 0 * * *"]
        },
        "telemetryIntervalSeconds": {
          "type": "integer",
          "minimum": 30,
          "maximum": 600,
          "default": 60,
          "description": "How often agent sends telemetry data"
        },
        "telemetryEnabled": {
          "type": "boolean",
          "default": true
        },
        "patchScanScheduleCron": {
          "type": "string",
          "description": "Cron expression for patch scanning"
        },
        "logLevel": {
          "type": "string",
          "enum": ["debug", "info", "warn", "error"],
          "default": "info"
        },
        "proxyUrl": {
          "type": "string",
          "format": "uri",
          "description": "HTTP proxy for agent communication"
        },
        "serverUrl": {
          "type": "string",
          "format": "uri",
          "description": "Backend server URL"
        }
      }
    },
    "AgentRegistrationRequest": {
      "type": "object",
      "description": "Payload sent by agent during registration",
      "required": ["machineId", "hostname", "os", "osVersion", "agentVersion"],
      "properties": {
        "machineId": {
          "type": "string",
          "description": "Unique machine identifier",
          "minLength": 16
        },
        "hostname": {
          "type": "string"
        },
        "os": {
          "$ref": "#/definitions/OSFamily"
        },
        "osVersion": {
          "type": "string"
        },
        "osBuild": {
          "type": "string"
        },
        "architecture": {
          "type": "string",
          "enum": ["x64", "x86", "arm64", "arm"]
        },
        "agentVersion": {
          "type": "string"
        },
        "serialNumber": {
          "type": "string"
        },
        "manufacturer": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "ipAddress": {
          "type": "string"
        },
        "macAddress": {
          "type": "string"
        },
        "timezone": {
          "type": "string",
          "examples": ["America/New_York", "Asia/Kolkata", "Europe/London"]
        },
        "locale": {
          "type": "string",
          "examples": ["en-US", "en-IN", "de-DE"]
        }
      }
    },
    "AgentRegistrationResponse": {
      "type": "object",
      "description": "Response from backend after successful registration",
      "required": ["agentId", "accessToken", "config"],
      "properties": {
        "agentId": {
          "type": "string",
          "format": "uuid"
        },
        "accessToken": {
          "type": "string",
          "description": "JWT token for subsequent API calls"
        },
        "refreshToken": {
          "type": "string",
          "description": "Token to refresh access token"
        },
        "assetId": {
          "type": "string",
          "format": "uuid",
          "description": "Linked or created asset ID"
        },
        "config": {
          "$ref": "#/definitions/AgentConfig"
        }
      }
    },
    "AgentHeartbeatRequest": {
      "type": "object",
      "description": "Heartbeat payload sent periodically",
      "required": ["timestamp", "status"],
      "properties": {
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "status": {
          "type": "string",
          "enum": ["healthy", "degraded", "error"]
        },
        "uptime": {
          "type": "integer",
          "description": "System uptime in seconds"
        },
        "agentUptime": {
          "type": "integer",
          "description": "Agent process uptime in seconds"
        },
        "cpuUsage": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "memoryUsage": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "diskUsage": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "pendingReboot": {
          "type": "boolean",
          "description": "Whether system requires reboot"
        },
        "lastError": {
          "type": "string",
          "description": "Last error message if status is error"
        },
        "ipAddress": {
          "type": "string",
          "description": "Current IP (may change)"
        }
      }
    },
    "AgentHeartbeatResponse": {
      "type": "object",
      "properties": {
        "acknowledged": {
          "type": "boolean"
        },
        "configUpdated": {
          "type": "boolean",
          "description": "Whether agent should fetch new config"
        },
        "commandsPending": {
          "type": "boolean",
          "description": "Whether there are commands to execute"
        },
        "inventoryRequested": {
          "type": "boolean",
          "description": "Backend requesting immediate inventory"
        }
      }
    },
    "AgentDownload": {
      "type": "object",
      "description": "Agent installer download information",
      "required": ["os", "version", "releaseDate", "downloadUrl"],
      "properties": {
        "id": {
          "type": "string"
        },
        "os": {
          "$ref": "#/definitions/OSFamily"
        },
        "architecture": {
          "type": "string",
          "enum": ["x64", "x86", "arm64", "universal"]
        },
        "version": {
          "type": "string"
        },
        "releaseDate": {
          "type": "string",
          "format": "date"
        },
        "downloadUrl": {
          "type": "string",
          "format": "uri"
        },
        "fileSize": {
          "type": "integer",
          "description": "File size in bytes"
        },
        "checksum": {
          "type": "string",
          "description": "SHA256 checksum of installer"
        },
        "releaseNotes": {
          "type": "string"
        },
        "minOsVersion": {
          "type": "string",
          "description": "Minimum OS version required"
        }
      }
    }
  },
  "$ref": "#/definitions/Agent"
}
