{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://patchify.io/schemas/asset.json",
  "title": "Asset",
  "description": "Unified asset schema representing a managed device with all collected data",
  "type": "object",
  "definitions": {
    "OperationalStatus": {
      "type": "string",
      "enum": ["Connected", "Disconnected"],
      "description": "Current connectivity status"
    },
    "AssetStatus": {
      "type": "string",
      "enum": ["In Use", "Available", "Under Maintenance", "Retired"],
      "description": "Asset lifecycle status"
    },
    "AssetType": {
      "type": "string",
      "enum": ["Computer", "Server", "Mobile", "Printer", "Laptop", "Tablet", "Desktop", "Virtual Machine"],
      "description": "Type of asset"
    },
    "Owner": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "phone": { "type": "string" },
        "department": { "type": "string" }
      }
    },
    "Location": {
      "type": "object",
      "properties": {
        "address": { "type": "string" },
        "city": { "type": "string" },
        "state": { "type": "string" },
        "country": { "type": "string" },
        "postalCode": { "type": "string" },
        "building": { "type": "string" },
        "floor": { "type": "string" },
        "room": { "type": "string" },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" }
      }
    },
    "AgentLink": {
      "type": "object",
      "description": "Link to the agent installed on this asset",
      "properties": {
        "agentId": {
          "type": "string",
          "format": "uuid",
          "description": "ID of the installed agent"
        },
        "agentName": { "type": "string" },
        "agentVersion": { "type": "string" },
        "agentStatus": {
          "type": "string",
          "enum": ["Connected", "Disconnected", "Pending", "Error"]
        },
        "lastHeartbeat": {
          "type": "string",
          "format": "date-time"
        },
        "registeredAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "PatchSummary": {
      "type": "object",
      "description": "Patch compliance summary for this asset",
      "properties": {
        "total": { "type": "integer" },
        "installed": { "type": "integer" },
        "missing": { "type": "integer" },
        "failed": { "type": "integer" },
        "pending": { "type": "integer" },
        "criticalMissing": { "type": "integer" },
        "securityMissing": { "type": "integer" },
        "lastScanDate": { "type": "string", "format": "date-time" },
        "lastScanRelative": { "type": "string" },
        "compliancePercent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "PerformanceSnapshot": {
      "type": "object",
      "description": "Current performance metrics",
      "properties": {
        "cpuUsage": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "memoryUsage": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "diskUsage": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "systemUptime": { "type": "string" },
        "systemUptimeSeconds": { "type": "integer" },
        "lastUpdated": { "type": "string", "format": "date-time" }
      }
    },
    "Procurement": {
      "type": "object",
      "properties": {
        "purchaseDate": { "type": "string", "format": "date" },
        "purchasePrice": { "type": "number" },
        "currency": { "type": "string" },
        "vendor": { "type": "string" },
        "invoiceNumber": { "type": "string" },
        "warrantyStartDate": { "type": "string", "format": "date" },
        "warrantyEndDate": { "type": "string", "format": "date" },
        "warrantyType": { "type": "string" },
        "amcStartDate": { "type": "string", "format": "date" },
        "amcEndDate": { "type": "string", "format": "date" },
        "amcVendor": { "type": "string" },
        "amcCost": { "type": "number" },
        "endOfLife": { "type": "string", "format": "date" },
        "endOfSupport": { "type": "string", "format": "date" }
      }
    },
    "Depreciation": {
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "enum": ["Straight Line", "Declining Balance", "Sum of Years", "None"]
        },
        "usefulLifeYears": { "type": "integer" },
        "salvageValue": { "type": "number" },
        "currentValue": { "type": "number" },
        "accumulatedDepreciation": { "type": "number" }
      }
    },
    "Asset": {
      "type": "object",
      "description": "Complete asset record",
      "required": ["id", "assetId", "name", "assetType", "status", "operationalStatus"],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "description": "Internal unique identifier"
        },
        "assetId": {
          "type": "string",
          "description": "User-facing asset ID (e.g., ASSET0001)"
        },
        "name": {
          "type": "string",
          "description": "Asset name"
        },
        "assetType": {
          "$ref": "#/definitions/AssetType"
        },
        "status": {
          "$ref": "#/definitions/AssetStatus"
        },
        "operationalStatus": {
          "$ref": "#/definitions/OperationalStatus"
        },
        "operationalStatusSince": {
          "type": "string",
          "format": "date-time"
        },
        "operationalStatusDuration": {
          "type": "string",
          "description": "Human-readable duration"
        },

        "systemIdentity": {
          "type": "object",
          "description": "Hardware identity",
          "properties": {
            "manufacturer": { "type": "string" },
            "model": { "type": "string" },
            "serialNumber": { "type": "string" },
            "uuid": { "type": "string" },
            "assetTag": { "type": "string" }
          }
        },

        "operatingSystem": {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "version": { "type": "string" },
            "build": { "type": "string" },
            "architecture": { "type": "string" },
            "installDate": { "type": "string", "format": "date" },
            "licenseStatus": { "type": "string" }
          }
        },

        "network": {
          "type": "object",
          "properties": {
            "hostname": { "type": "string" },
            "domainName": { "type": "string" },
            "ipAddress": { "type": "string" },
            "macAddress": { "type": "string" },
            "isDomainJoined": { "type": "boolean" }
          }
        },

        "agent": {
          "$ref": "#/definitions/AgentLink"
        },

        "patchSummary": {
          "$ref": "#/definitions/PatchSummary"
        },

        "performance": {
          "$ref": "#/definitions/PerformanceSnapshot"
        },

        "owner": {
          "$ref": "#/definitions/Owner"
        },

        "location": {
          "type": "object",
          "properties": {
            "base": { "$ref": "#/definitions/Location" },
            "current": { "$ref": "#/definitions/Location" }
          }
        },

        "branchId": {
          "type": "string",
          "description": "Branch/office this asset belongs to"
        },
        "branchName": {
          "type": "string"
        },

        "categoryId": { "type": "string" },
        "subCategoryId": { "type": "string" },
        "tagIds": {
          "type": "array",
          "items": { "type": "string" }
        },

        "groups": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" }
            }
          },
          "description": "Endpoint groups for deployment targeting"
        },

        "procurement": {
          "$ref": "#/definitions/Procurement"
        },

        "depreciation": {
          "$ref": "#/definitions/Depreciation"
        },

        "lastInventoryAt": {
          "type": "string",
          "format": "date-time",
          "description": "When full inventory was last collected"
        },

        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "createdBy": { "type": "string" },
        "updatedBy": { "type": "string" }
      }
    },
    "AssetDetail": {
      "type": "object",
      "description": "Asset with all detailed inventory data",
      "allOf": [
        { "$ref": "#/definitions/Asset" },
        {
          "type": "object",
          "properties": {
            "hardware": {
              "description": "Full hardware inventory",
              "$comment": "See hardware.schema.json"
            },
            "software": {
              "description": "Full software inventory",
              "$comment": "See software.schema.json"
            },
            "networkConfig": {
              "description": "Detailed network configuration",
              "$comment": "See network.schema.json"
            },
            "security": {
              "description": "Security compliance data",
              "$comment": "See security.schema.json"
            },
            "peripherals": {
              "description": "Connected peripherals",
              "$comment": "See peripheral.schema.json"
            },
            "telemetry": {
              "description": "Recent telemetry data",
              "$comment": "See telemetry.schema.json"
            }
          }
        }
      ]
    }
  },
  "$ref": "#/definitions/Asset"
}
